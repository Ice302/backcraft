+            fx.set_param("amount", 0.0);
+            fx.set_param("output", 0.0);
+            let lat = fx.latency();
+            let x = noise(3, (sr as usize).max(lat * 3), 0.5);
+            let mut y = vec![x.clone(), x.clone()];
+            run(&mut fx, &mut y);
+            for i in lat..x.len() {
+                assert!((y[0][i] - x[i - lat]).abs() < 1e-4, "sr {sr} i {i}: {} vs {}", y[0][i], x[i - lat]);
+            }
+        }
+    }
