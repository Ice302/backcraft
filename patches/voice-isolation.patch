+// --------------------------------------------------------------------- voice isolation
+
+/// Length of the before/after window around the playhead (s), the analysis pre-roll before it
+/// (the noise tracker's warm-up) and the number of plot columns.
+const VOICE_VIEW_S: f64 = 3.0;
+const VOICE_PREROLL_S: f64 = 1.5;
+const VOICE_COLS: usize = 330;
+
+/// What the Voice Isolation effect does around the playhead: the effect's input and output
+/// envelopes, the voice-activity estimate and summary numbers, computed by the real DSP.
+#[derive(Clone, Debug, Default)]
+struct VoiceView {
+    /// Peak envelope per column (max |x| over the channels) of the input and output.
+    input: Vec<f32>,
+    output: Vec<f32>,
+    /// Speech-presence probability per column (0…1).
+    voice: Vec<f32>,
+    /// Window start and length in sequence samples.
+    start: i64,
+    len: usize,
+    /// Share of the window detected as voice, mean gain (dB) and median pitch (Hz, 0: none).
+    voiced_share: f32,
+    gain_db: f32,
+    pitch_hz: f32,
+    /// Why there is nothing to show (an English `tl!` key).
+    note: Option<&'static str>,
+}
+
+/// Presets: (automation suffix, label, amount, sensitivity, floor, center focus).
+const VOICE_PRESETS: [(&str, &str, f64, f64, f64, f64); 4] = [
+    ("gentle", "Gentle", 60.0, 45.0, -30.0, 15.0),
+    ("balanced", "Balanced", 85.0, 65.0, -48.0, 30.0),
+    ("strong", "Strong", 100.0, 85.0, -70.0, 40.0),
+    ("music", "Music Bed", 100.0, 90.0, -60.0, 70.0),
+];
+
+/// The view for an editor and the playhead's place in it (0…1, `None` outside). Cached by
+/// (target, project revision, window, settings) and recomputed only while no drag is in progress
+/// and playback is stopped, so editing and playback stay smooth.
+fn voice_view(app: &FilmcraftApp, ctx: &egui::Context, target: &FxTarget, ed: &Ed) -> (Arc<VoiceView>, Option<f32>) {
+    let id = egui::Id::new(("fx-editor-voice-view", key(target)));
+    let cached: Option<(String, Arc<VoiceView>)> = ctx.data(|d| d.get_temp(id));
+    let Some(seq) = app.session.active_sequence() else {
+        return (Arc::new(VoiceView { note: Some("No sequence is open."), ..VoiceView::default() }), None);
+    };
+    let sr = seq.settings.sample_rate.clamp(8000, 384_000);
+    let ph = app.session.playhead().to_units_floor(i64::from(sr));
+    let len = (VOICE_VIEW_S * f64::from(sr)) as usize;
+    // window start on a half-second grid, so small playhead moves don't recompute
+    let half = i64::from(sr / 2).max(1);
+    let start = (ph - len as i64 / 2).div_euclid(half) * half;
+    let preview = ed.preview();
+    let settings: Vec<String> = VoiceIsolator::PARAMS.iter().map(|p| format!("{:.3}", preview.f64_at(p.id, ed.mt))).collect();
+    let k = format!("{}|{}|{start}|{sr}|{}", key(target), app.session.revision, settings.join(","));
+    let view = match cached {
+        Some((ck, v)) if ck == k || !ed.drafts.is_empty() || app.playback.playing => v,
+        _ => {
+            let v = Arc::new(compute_voice_view(app, seq, target, &preview, ed.mt, start, len, sr));
+            ctx.data_mut(|d| d.insert_temp(id, (k, v.clone())));
+            v
+        }
+    };
+    let at = (ph - view.start) as f64 / view.len.max(1) as f64;
+    let at = (view.len > 0 && (0.0..=1.0).contains(&at)).then_some(at as f32);
+    (view, at)
+}
+
+fn compute_voice_view(app: &FilmcraftApp, seq: &Sequence, target: &FxTarget, inst: &EffectInstance, mt: Tick, start: i64, len: usize, sr: u32) -> VoiceView {
+    let none = |note| VoiceView { start, len, note: Some(note), ..VoiceView::default() };
+    let pre = (VOICE_PREROLL_S * f64::from(sr)) as usize;
+    let mut fx = VoiceIsolator::new(sr as f32, 2);
+    for p in VoiceIsolator::PARAMS {
+        fx.set_param(p.id, inst.f64_at(p.id, mt) as f32);
+    }
+    let lat = fx.latency();
+    let total = pre + len + lat;
+    let x0 = start - pre as i64;
+    let provider = app.session.media.provider(app.session.project.clone(), app.session.services.clone());
+    let mut chans: Vec<Vec<f32>> = match target {
+        FxTarget::Clip { clip, index } => {
+            let Some((_, it)) = seq.find_item(ClipId(*clip)) else { return none("The clip is no longer in the sequence.") };
+            // the effect's input: the clip with only the effects before this one
+            let mut src = it.clone();
+            src.effects.truncate(*index);
+            match filmcraft_render::audio::clip_signal(&src, x0, total, sr, &provider) {
+                Some([l, r]) => vec![l, r],
+                None => return none("This clip has no audio to preview."),
+            }
+        }
+        FxTarget::Insert { strip, .. } => {
+            let Some(tr) = seq.strip(TrackId(*strip)) else { return none("The track is no longer in the sequence.") };
+            filmcraft_render::audio::track_input(&app.session.project, &tr, x0, total, sr, &provider).channels.into_iter().take(2).collect()
+        }
+    };
+    if let [only] = chans.as_slice() {
+        chans.push(only.clone());
+    }
+    if chans.len() != 2 || chans.iter().any(|c| c.len() < total) {
+        return none("This clip has no audio to preview.");
+    }
+    let input: Vec<Vec<f32>> = chans.iter().map(|c| c.get(pre..pre + len).unwrap_or(&[]).to_vec()).collect();
+    if input.iter().flatten().all(|v| *v == 0.0) {
+        return none("No audio at the playhead.");
+    }
+    // process in blocks, sampling the meter (it describes the frame output `lat` samples ago)
+    const BLOCK: usize = 256;
+    let cols = VOICE_COLS;
+    let mut voice = vec![0.0f32; cols];
+    let mut voice_n = vec![0u32; cols];
+    let (mut gain_sum, mut reads, mut voiced) = (0.0f64, 0u32, 0u32);
+    let mut pitches = Vec::new();
+    let mut pos = 0usize;
+    while pos < total {
+        let end = (pos + BLOCK).min(total);
+        let mut refs: Vec<&mut [f32]> = chans.iter_mut().filter_map(|c| c.get_mut(pos..end)).collect();
+        fx.process(&mut refs);
+        pos = end;
+        let at = pos as i64 - lat as i64 - pre as i64;
+        if at < 0 || at as usize >= len {
+            continue;
+        }
+        let m = fx.meter();
+        let c = (at as usize * cols / len.max(1)).min(cols - 1);
+        voice[c] += m.voice;
+        voice_n[c] += 1;
+        gain_sum += f64::from(m.reduction_db);
+        reads += 1;
+        voiced += u32::from(m.voice > 0.5);
+        if m.pitch_hz > 0.0 {
+            pitches.push(m.pitch_hz);
+        }
+    }
+    for (v, n) in voice.iter_mut().zip(&voice_n) {
+        if *n > 0 {
+            *v /= *n as f32;
+        }
+    }
+    let output: Vec<Vec<f32>> = chans.iter().map(|c| c.get(pre + lat..pre + lat + len).unwrap_or(&[]).to_vec()).collect();
+    let env = |sig: &[Vec<f32>]| -> Vec<f32> {
+        (0..cols)
+            .map(|c| {
+                let (a, b) = (c * len / cols, ((c + 1) * len / cols).min(len));
+                sig.iter().flat_map(|ch| ch.get(a..b).unwrap_or(&[])).fold(0.0f32, |m, v| if v.is_finite() { m.max(v.abs()) } else { m })
+            })
+            .collect()
+    };
+    pitches.sort_by(f32::total_cmp);
+    VoiceView {
+        input: env(&input),
+        output: env(&output),
+        voice,
+        start,
+        len,
+        voiced_share: if reads > 0 { voiced as f32 / reads as f32 } else { 0.0 },
+        gain_db: if reads > 0 { (gain_sum / f64::from(reads)) as f32 } else { 0.0 },
+        pitch_hz: pitches.get(pitches.len() / 2).copied().unwrap_or(0.0),
+        note: None,
+    }
+}
+
+/// The Voice Isolation editor: before/after view with the voice-activity strip, presets, the
+/// listen switch and every setting.
+fn voice(ui: &mut egui::Ui, ed: &mut Ed, view: Option<(&VoiceView, Option<f32>)>) {
+    let t = ed.t;
+    let background = ed.v("listen") >= 0.5;
+    let kept_col = if background { Color32::from_rgb(0xf0, 0x9a, 0x3e) } else { Color32::from_rgb(0x4d, 0xa3, 0xff) };
+    let voice_col = Color32::from_rgb(0x3f, 0xb9, 0x50);
+    // ---- before / after plot and the voice-activity strip under it
+    let (r, _) = ui.allocate_exact_size(vec2(660.0, 150.0), Sense::hover());
+    let p = ui.painter_at(r);
+    p.rect_filled(r, 2.0, t.plot_bg);
+    p.line_segment([pos2(r.min.x, r.center().y), pos2(r.max.x, r.center().y)], Stroke::new(1.0, t.plot_grid));
+    let (vr, _) = ui.allocate_exact_size(vec2(660.0, 10.0), Sense::hover());
+    ui.painter().rect_filled(vr, 1.0, t.plot_bg);
+    let stats = match view {
+        Some((v, playhead)) if v.note.is_none() => {
+            let cols = v.input.len().min(v.output.len()).min(v.voice.len()).max(1);
+            let w = r.width() / cols as f32;
+            // one scale for both: the louder envelope fills 90 % of the half-height
+            let peak = v.input.iter().chain(&v.output).fold(1e-6f32, |m, x| m.max(*x));
+            let h = r.height() * 0.45 / peak;
+            let dim = t.text_faint.gamma_multiply(0.6);
+            for c in 0..cols {
+                let x = r.min.x + (c as f32 + 0.5) * w;
+                let (a, b) = (v.input.get(c).copied().unwrap_or(0.0), v.output.get(c).copied().unwrap_or(0.0));
+                p.line_segment([pos2(x, r.center().y - a * h), pos2(x, r.center().y + a * h)], Stroke::new(w.max(1.0), dim));
+                p.line_segment([pos2(x, r.center().y - b * h), pos2(x, r.center().y + b * h)], Stroke::new((w * 0.6).max(1.0), kept_col));
+                let a = v.voice.get(c).copied().unwrap_or(0.0).clamp(0.0, 1.0);
+                if a > 0.02 {
+                    let cell = Rect::from_min_max(pos2(vr.min.x + c as f32 * w, vr.min.y), pos2(vr.min.x + (c + 1) as f32 * w, vr.max.y));
+                    ui.painter().rect_filled(cell, 0.0, voice_col.gamma_multiply(a));
+                }
+            }
+            if let Some(f) = playhead {
+                let x = r.min.x + f * r.width();
+                ui.painter().line_segment([pos2(x, r.min.y), pos2(x, vr.max.y)], Stroke::new(1.0, t.focus));
+            }
+            let label = if background { tl!("Removed") } else { tl!("Kept") };
+            p.text(pos2(r.min.x + 6.0, r.min.y + 4.0), Align2::LEFT_TOP, format!("■ {}", tl!("Original")), Tokens::ui(10.5), t.text_dim);
+            p.text(pos2(r.min.x + 100.0, r.min.y + 4.0), Align2::LEFT_TOP, format!("■ {label}"), Tokens::ui(10.5), kept_col);
+            Some((v.voiced_share, v.gain_db, v.pitch_hz))
+        }
+        Some((v, _)) => {
+            let note = v.note.map_or(tl!("No audio at the playhead."), crate::i18n::t);
+            p.text(r.center(), Align2::CENTER_CENTER, note, Tokens::ui(12.0), t.text_faint);
+            None
+        }
+        None => None,
+    };
+    ed.auto(format!("fxEditor.{}.view", ed.fx), r, "Before / After");
+    ed.auto(format!("fxEditor.{}.voice", ed.fx), vr, "Voice Activity");
+    ui.horizontal(|ui| {
+        ui.colored_label(voice_col, "■");
+        match stats {
+            Some((share, gain, pitch)) => {
+                ui.label(tlf!("Voice detected: {pct} %", pct = format!("{:.0}", share * 100.0)));
+                ui.separator();
+                ui.label(tlf!("Average gain: {db} dB", db = format!("{gain:+.1}")));
+                if pitch > 0.0 {
+                    ui.separator();
+                    ui.label(tlf!("Pitch: {hz} Hz", hz = format!("{pitch:.0}")));
+                }
+            }
+            None => {
+                ui.label(tl!("Voice activity"));
+            }
+        }
+    });
+    ui.add_space(4.0);
+    // ---- presets and the listen switch
+    ui.horizontal(|ui| {
+        ui.label(tl!("Presets:"));
+        for (id, label, amount, sens, floor, centre) in VOICE_PRESETS {
+            let label = crate::i18n::t(label);
+            let near = |pid: &str, v: f64| (ed.v(pid) - v).abs() < 0.5;
+            let active = near("amount", amount) && near("sensitivity", sens) && near("floor", floor) && near("center_focus", centre);
+            let r = ui.selectable_label(active, label);
+            ed.auto(format!("fxEditor.{}.preset.{id}", ed.fx), r.rect, label);
+            if r.clicked() {
+                ed.commit_many(&[("amount", amount), ("sensitivity", sens), ("floor", floor), ("center_focus", centre)]);
+            }
+        }
+        ui.separator();
+        ui.label(tl!("Listen:"));
+        for (i, opt) in filmcraft_project::effect::VOICE_ISOLATION_OUTPUTS.iter().enumerate() {
+            let label = crate::i18n::t(opt);
+            let r = ui.selectable_label(usize::from(background) == i, label);
+            ed.auto(format!("fxEditor.{}.listen.{i}", ed.fx), r.rect, label);
+            if r.clicked() {
+                ed.commit("listen", i as f64);
+            }
+        }
+    });
+    ui.separator();
+    // ---- settings
+    ui.horizontal_top(|ui| {
+        ui.vertical(|ui| {
+            ui.set_width(325.0);
+            ed.slider(ui, "amount", tl!("Amount"), false);
+            ed.slider(ui, "sensitivity", tl!("Sensitivity"), false);
+            ed.slider(ui, "floor", tl!("Background Floor"), false);
+        });
+        ui.vertical(|ui| {
+            ui.set_width(325.0);
+            ed.slider(ui, "center_focus", tl!("Center Focus"), false);
+            ed.slider(ui, "output", tl!("Output Gain"), false);
+            ui.horizontal(|ui| {
+                ed.toggle(ui, "preserve_formants", tl!("Preserve Formants"));
+                let r = ui.button(tl!("Reset"));
+                ed.auto(format!("fxEditor.{}.reset", ed.fx), r.rect, "Reset");
+                if r.clicked() {
+                    let defaults: Vec<(&str, f64)> =
+                        ed.inst.def().map(|d| d.params.iter().filter_map(|p| p.default.as_f64().map(|v| (p.id, v))).collect()).unwrap_or_default();
+                    ed.commit_many(&defaults);
+                }
+            });
+        });
+    });
+}
